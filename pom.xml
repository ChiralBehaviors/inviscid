<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.chiralbehaviors.inviscid</groupId>
    <artifactId>inviscid</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Inviscid</name>
    <description>Cellular automata using jitterbugs</description>

    <properties>
        <javafx.version>20</javafx.version>
        <maven.compiler.source>20</maven.compiler.source>
        <maven.compiler.target>20</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <licenses>
        <license>
            <name>Apache License Version 2.0</name>
            <url>http://www.apache.org/licenses/</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hal Hildebrand</name>
            <email>hal.hildebrand@me.com</email>
            <organization>Chiral Behaviors</organization>
        </developer>
    </developers>

    <scm>
        <connection>git://github.com/ChiralBehaviors/inviscid.git</connection>
        <url>https://github.com/ChiralBehaviors/inviscid</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>javax.vecmath</groupId>
            <artifactId>vecmath</artifactId>
            <version>1.5.2</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- SVD, eigendecomposition and least-squares solves for the jitterbug
             configuration-variety measurements (rank/nullity of the constraint
             Jacobian, Kabsch alignment, Newton projection onto the variety).
             TEST SCOPE ONLY: src/main stays on javax.vecmath and plain arithmetic.
             If production code needs this, that is a design change to argue for,
             not a scope widening to slip in. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-XDstringConcat=inline</arg>
                    </compilerArgs>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                            <goal>test-jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <attach>true</attach>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Opt-in exclusion of the retired LGA arc's tests (epic inviscid-0nx,
            closed by owner decision). Activated ONLY by -DskipLga, so a plain
            `mvn test` still runs everything: the LGA code is frozen, not dead,
            and inviscid-1zr / yj3 / 8uh / ip2 are open bugs filed against it
            whose tests must run for whoever picks them up.

            CI passes -DskipLga on the push gate. On the runners we were getting
            in August 2026 the lga.* classes were 799s of a 932s run: 86%, with
            HybridAutomatonTest alone 34%, for an arc no longer under
            development.

            KNOWN GAP, deliberate: Necronomata and the rest of the core sit
            underneath BOTH arcs, so a core change can now break LGA without CI
            noticing. The full suite is one flag away (`mvn test`, no property)
            and that is the intended recovery.
        -->
        <profile>
            <id>skip-lga-tests</id>
            <activation>
                <property>
                    <name>skipLga</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/lga/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>